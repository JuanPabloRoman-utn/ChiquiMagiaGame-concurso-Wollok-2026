import wollok.game.*
import Personajes.*
import Salas.*

program juego {
  game.title("Chiqui Mafia Game")
  game.cellSize(64)
  game.width(20)
  game.height(12)

  // Arranca en el menú principal. ENTER avanza (menú -> patio, cartel -> hall).
  director.mostrarMenu()
  keyboard.enter().onPressDo({ director.confirmar() })

  // Movimiento casilla por casilla (WASD). El director maneja todo.
  keyboard.w().onPressDo({ jugador.mirar(true)  director.moverJugador({ pos => pos.up(1) }) })
  keyboard.s().onPressDo({ jugador.mirar(false) director.moverJugador({ pos => pos.down(1) }) })
  keyboard.a().onPressDo({ jugador.mirar(false) director.moverJugador({ pos => pos.left(1) }) })
  keyboard.d().onPressDo({ jugador.mirar(false) director.moverJugador({ pos => pos.right(1) }) })

  // --- Teclas de modo test (solo sirven si config.debug = true) ---
  // T/B/C: saltar directo a Toviggino / Beligoy / Caruso. U: completar todo y volver al hall.
  keyboard.t().onPressDo({ director.saltarA(salaToviggino) })
  keyboard.b().onPressDo({ director.saltarA(salaBeligoy) })
  keyboard.c().onPressDo({ director.saltarA(salaCaruso) })
  keyboard.u().onPressDo({ director.completarTodo() })

  // Indicadores (flechas verdes) titilando.
  game.onTick(450, "titilar", { director.titilar() })

  game.start()
}
