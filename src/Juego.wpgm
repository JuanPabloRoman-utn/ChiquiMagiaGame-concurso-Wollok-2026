
import wollok.game.*
import Personajes.*

program juego {
  game.title("Chiqui vs Detective")
  game.height(10)
  game.width(15)

  game.addVisual(chiqui)
  game.addVisual(detective)

  // --- CONTROLES WASD ---
  keyboard.w().onPressDo({ detective.moverA(detective.position().up(1)) })
  keyboard.s().onPressDo({ detective.moverA(detective.position().down(1)) })
  keyboard.a().onPressDo({ detective.moverA(detective.position().left(1)) })
  keyboard.d().onPressDo({ detective.moverA(detective.position().right(1)) })

  // --- ATAQUE AUTOMÁTICO ---
  // El Chiqui intenta pegarle al detective cada 2000 ms (2 segundos)
  game.onTick(2000, "ataqueChiqui", {
    chiqui.revolear()
  })

  game.onTick(2000, "ataqueDetective", {
    detective.revolear()
  })


  // --- COLISIÓN ---
  game.onCollideDo(detective, { elemento =>
    elemento.desaparecer()
    detective.recibirDanio()
  })

  game.onCollideDo(chiqui, { elemento =>
    elemento.desaparecer()
    chiqui.recibirDanio()
  })

  game.start()
}
